{
    "database_schema": {
      "description": "Структура базы данных для Telegram бота-агрегатора контента",
      "tables": {
        "TelegramAccount": {
          "description": "Аккаунты пользователей Telegram",
          "fields": [
            {
              "name": "telegram_account_id",
              "type": "BIGINT",
              "primary_key": true,
              "unique": true,
              "nullable": false,
              "description": "Уникальный ID пользователя из Telegram"
            },
            {
              "name": "telegram_username",
              "type": "VARCHAR(32)",
              "nullable": true,
              "description": "@username пользователя"
            },
            {
              "name": "telegram_first_name",
              "type": "VARCHAR(64)",
              "nullable": false,
              "description": "Имя пользователя"
            },
            {
              "name": "telegram_last_name",
              "type": "VARCHAR(64)",
              "nullable": true,
              "description": "Фамилия пользователя"
            },
            {
              "name": "is_bot_blocked",
              "type": "BOOLEAN",
              "default": "FALSE",
              "description": "Флаг блокировки бота пользователем"
            },
            {
              "name": "telegram_language_code",
              "type": "VARCHAR(10)",
              "nullable": true,
              "description": "Языковой код пользователя"
            },
            {
              "name": "registration_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Дата и время регистрации"
            },
            {
              "name": "last_activity",
              "type": "TIMESTAMP",
              "nullable": true,
              "description": "Последняя активность пользователя"
            },
            {
              "name": "telegram_photo_url",
              "type": "TEXT",
              "nullable": true,
              "description": "URL аватара пользователя"
            },
            {
              "name": "state",
              "type": "VARCHAR(50)",
              "nullable": true,
              "description": "Текущее состояние в FSM (Finite State Machine)"
            }
          ],
          "relationships": [
            {
              "type": "one_to_many",
              "target_table": "GroupMembership",
              "foreign_key": "telegram_account_id"
            },
            {
              "type": "one_to_many",
              "target_table": "ContentSource",
              "foreign_key": "created_by_telegram_account_id"
            },
            {
              "type": "one_to_many",
              "target_table": "GroupTopic",
              "foreign_key": "created_by_telegram_account_id"
            },
            {
              "type": "one_to_many",
              "target_table": "SourceSubscription",
              "foreign_key": "added_by_telegram_account_id"
            }
          ]
        },
        "ManagedGroup": {
          "description": "Группы/супергруппы Telegram, куда добавлен бот",
          "fields": [
            {
              "name": "telegram_chat_id",
              "type": "BIGINT",
              "primary_key": true,
              "unique": true,
              "nullable": false,
              "description": "Уникальный ID чата (отрицательный для групп)"
            },
            {
              "name": "telegram_chat_title",
              "type": "VARCHAR(255)",
              "nullable": false,
              "description": "Название группы"
            },
            {
              "name": "chat_type",
              "type": "ENUM('group', 'supergroup')",
              "nullable": false,
              "description": "Тип чата"
            },
            {
              "name": "bot_role_in_group",
              "type": "ENUM('administrator', 'member')",
              "nullable": false,
              "description": "Роль бота в группе"
            },
            {
              "name": "bot_added_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Когда бот был добавлен в группу"
            },
            {
              "name": "is_bot_active_in_group",
              "type": "BOOLEAN",
              "default": "TRUE",
              "description": "Флаг активности бота в группе"
            }
          ],
          "relationships": [
            {
              "type": "one_to_many",
              "target_table": "GroupMembership",
              "foreign_key": "telegram_chat_id"
            },
            {
              "type": "one_to_many",
              "target_table": "GroupTopic",
              "foreign_key": "telegram_chat_id"
            },
            {
              "type": "one_to_many",
              "target_table": "SourceSubscription",
              "foreign_key": "telegram_chat_id"
            },
            {
              "type": "one_to_many",
              "target_table": "TopicSourceAssignment",
              "foreign_key": "telegram_chat_id"
            }
          ]
        },
        "GroupMembership": {
          "description": "Связь пользователей с группами и их роли",
          "fields": [
            {
              "name": "membership_id",
              "type": "SERIAL",
              "primary_key": true,
              "unique": true,
              "description": "Уникальный ID записи о членстве"
            },
            {
              "name": "telegram_account_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на TelegramAccount",
              "foreign_key": "TelegramAccount.telegram_account_id"
            },
            {
              "name": "telegram_chat_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на ManagedGroup",
              "foreign_key": "ManagedGroup.telegram_chat_id"
            },
            {
              "name": "user_role_in_group",
              "type": "ENUM('owner', 'administrator', 'member')",
              "nullable": false,
              "description": "Роль пользователя в группе"
            },
            {
              "name": "permissions_level",
              "type": "INTEGER",
              "default": "1",
              "description": "Уровень прав пользователя в группе"
            }
          ],
          "unique_constraints": [
            {
              "name": "unique_user_group",
              "fields": ["telegram_account_id", "telegram_chat_id"],
              "description": "Пользователь может быть членом группы только один раз"
            }
          ],
          "indexes": [
            {
              "name": "idx_user_groups",
              "fields": ["telegram_account_id"],
              "description": "Для быстрого поиска групп пользователя"
            },
            {
              "name": "idx_group_members",
              "fields": ["telegram_chat_id"],
              "description": "Для быстрого поиска членов группы"
            }
          ]
        },
        "GroupTopic": {
          "description": "Темы (треды) внутри групп Telegram",
          "fields": [
            {
              "name": "topic_identifier",
              "type": "VARCHAR(128)",
              "primary_key": true,
              "unique": true,
              "description": "Уникальный идентификатор темы (формат: group:{chat_id}:thread:{thread_id})"
            },
            {
              "name": "telegram_chat_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на ManagedGroup",
              "foreign_key": "ManagedGroup.telegram_chat_id"
            },
            {
              "name": "telegram_message_thread_id",
              "type": "INTEGER",
              "nullable": false,
              "description": "ID треда в Telegram (1 для General)"
            },
            {
              "name": "topic_name",
              "type": "VARCHAR(255)",
              "nullable": false,
              "description": "Название темы"
            },
            {
              "name": "topic_type",
              "type": "ENUM('general', 'created_by_bot', 'existing_topic')",
              "nullable": false,
              "description": "Тип темы"
            },
            {
              "name": "access_mode",
              "type": "ENUM('read_only', 'standard')",
              "nullable": false,
              "description": "Режим доступа к теме"
            },
            {
              "name": "created_by_telegram_account_id",
              "type": "BIGINT",
              "nullable": true,
              "description": "Ссылка на создателя темы",
              "foreign_key": "TelegramAccount.telegram_account_id"
            },
            {
              "name": "created_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Дата и время создания темы"
            }
          ],
          "unique_constraints": [
            {
              "name": "unique_topic_in_group",
              "fields": ["telegram_chat_id", "telegram_message_thread_id"],
              "description": "В рамках одной группы тема должна быть уникальной"
            }
          ],
          "relationships": [
            {
              "type": "one_to_many",
              "target_table": "TopicSourceAssignment",
              "foreign_key": "topic_identifier"
            }
          ]
        },
        "ContentSource": {
          "description": "Публичные источники контента (каналы, YouTube, RSS и т.д.)",
          "fields": [
            {
              "name": "source_global_id",
              "type": "VARCHAR(64)",
              "primary_key": true,
              "unique": true,
              "description": "Глобальный уникальный ID источника (хеш)"
            },
            {
              "name": "source_type",
              "type": "ENUM('telegram_channel', 'youtube_channel', 'rss_feed', 'twitter_profile')",
              "nullable": false,
              "description": "Тип источника"
            },
            {
              "name": "source_identifier",
              "type": "VARCHAR(255)",
              "nullable": false,
              "description": "Идентификатор источника (username, channel_id, URL и т.д.)"
            },
            {
              "name": "source_display_name",
              "type": "VARCHAR(255)",
              "nullable": false,
              "description": "Отображаемое имя источника"
            },
            {
              "name": "verification_status",
              "type": "ENUM('pending', 'verified', 'invalid')",
              "nullable": false,
              "description": "Статус проверки источника"
            },
            {
              "name": "created_by_telegram_account_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на создателя источника",
              "foreign_key": "TelegramAccount.telegram_account_id"
            },
            {
              "name": "created_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Дата и время создания записи"
            },
            {
              "name": "last_checked",
              "type": "TIMESTAMP",
              "nullable": true,
              "description": "Когда источник последний раз проверялся"
            }
          ],
          "unique_constraints": [
            {
              "name": "unique_source_by_type_and_id",
              "fields": ["source_type", "source_identifier"],
              "description": "Комбинация типа и идентификатора должна быть уникальной"
            }
          ],
          "relationships": [
            {
              "type": "one_to_many",
              "target_table": "SourceSubscription",
              "foreign_key": "source_global_id"
            },
            {
              "type": "one_to_many",
              "target_table": "TopicSourceAssignment",
              "foreign_key": "source_global_id"
            }
          ]
        },
        "SourceSubscription": {
          "description": "Подписка группы на источник контента",
          "fields": [
            {
              "name": "subscription_hash",
              "type": "VARCHAR(64)",
              "primary_key": true,
              "unique": true,
              "description": "Уникальный хеш подписки"
            },
            {
              "name": "telegram_chat_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на ManagedGroup",
              "foreign_key": "ManagedGroup.telegram_chat_id"
            },
            {
              "name": "source_global_id",
              "type": "VARCHAR(64)",
              "nullable": false,
              "description": "Ссылка на ContentSource",
              "foreign_key": "ContentSource.source_global_id"
            },
            {
              "name": "added_by_telegram_account_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Ссылка на добавившего пользователя",
              "foreign_key": "TelegramAccount.telegram_account_id"
            },
            {
              "name": "subscription_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Дата и время добавления подписки"
            },
            {
              "name": "is_active",
              "type": "BOOLEAN",
              "default": "TRUE",
              "description": "Флаг активности подписки"
            },
            {
              "name": "last_post_timestamp",
              "type": "TIMESTAMP",
              "nullable": true,
              "description": "Когда последний раз публиковался контент"
            },
            {
              "name": "settings",
              "type": "JSONB",
              "default": "'{}'",
              "description": "Настройки подписки (auto_publish и др.)"
            }
          ],
          "unique_constraints": [
            {
              "name": "unique_group_source",
              "fields": ["telegram_chat_id", "source_global_id"],
              "description": "❗ КЛЮЧЕВОЕ ПРАВИЛО: один источник можно добавить в группу только один раз"
            }
          ],
          "indexes": [
            {
              "name": "idx_group_subscriptions",
              "fields": ["telegram_chat_id"],
              "description": "Для поиска всех подписок группы"
            },
            {
              "name": "idx_source_subscriptions",
              "fields": ["source_global_id"],
              "description": "Для поиска всех групп, подписанных на источник"
            }
          ],
          "business_rules": [
            {
              "rule": "BR001",
              "description": "Запрет дублирования источника в группе",
              "condition": "При создании проверяется уникальность (telegram_chat_id, source_global_id)"
            }
          ]
        },
        "TopicSourceAssignment": {
          "description": "Назначение источника в конкретную тему группы",
          "fields": [
            {
              "name": "assignment_id",
              "type": "SERIAL",
              "primary_key": true,
              "unique": true,
              "description": "Уникальный ID назначения"
            },
            {
              "name": "topic_identifier",
              "type": "VARCHAR(128)",
              "nullable": false,
              "description": "Ссылка на GroupTopic",
              "foreign_key": "GroupTopic.topic_identifier"
            },
            {
              "name": "source_global_id",
              "type": "VARCHAR(64)",
              "nullable": false,
              "description": "Ссылка на ContentSource",
              "foreign_key": "ContentSource.source_global_id"
            },
            {
              "name": "telegram_chat_id",
              "type": "BIGINT",
              "nullable": false,
              "description": "Дублирование для быстрого поиска, ссылка на ManagedGroup",
              "foreign_key": "ManagedGroup.telegram_chat_id"
            },
            {
              "name": "created_timestamp",
              "type": "TIMESTAMP",
              "nullable": false,
              "description": "Дата и время создания назначения"
            },
            {
              "name": "custom_settings",
              "type": "JSONB",
              "default": "'{}'",
              "description": "Кастомные настройки для источника в теме"
            }
          ],
          "unique_constraints": [
            {
              "name": "unique_topic_source",
              "fields": ["topic_identifier", "source_global_id"],
              "description": "Источник может быть назначен в тему только один раз"
            }
          ],
          "indexes": [
            {
              "name": "idx_topic_assignments",
              "fields": ["topic_identifier"],
              "description": "Для поиска всех источников в теме"
            },
            {
              "name": "idx_source_assignments",
              "fields": ["source_global_id"],
              "description": "Для поиска всех назначений источника"
            },
            {
              "name": "idx_group_topic_assignments",
              "fields": ["telegram_chat_id"],
              "description": "Для быстрого поиска по группе"
            }
          ],
          "integrity_constraints": [
            {
              "name": "integrity_group_topic",
              "condition": "GroupTopic.telegram_chat_id = TopicSourceAssignment.telegram_chat_id",
              "description": "Группа в назначении должна совпадать с группой темы"
            },
            {
              "name": "integrity_subscription_exists",
              "condition": "Должна существовать SourceSubscription для этой пары (telegram_chat_id, source_global_id)",
              "description": "Назначение возможно только если есть подписка группы на источник"
            }
          ]
        }
      },
      "key_business_rules": [
        {
          "id": "BR_MAIN_001",
          "description": "Один источник → одна группа",
          "implementation": "UNIQUE constraint on SourceSubscription(telegram_chat_id, source_global_id)",
          "error_message": "Источник уже добавлен в эту группу"
        },
        {
          "id": "BR_MAIN_002",
          "description": "Пользователь должен быть членом группы для управления ей",
          "implementation": "Проверка GroupMembership перед операциями",
          "error_message": "Пользователь не является членом этой группы"
        },
        {
          "id": "BR_MAIN_003",
          "description": "Бот должен быть администратором для создания тем",
          "implementation": "Проверка ManagedGroup.bot_role_in_group = 'administrator'",
          "error_message": "Бот не является администратором в этой группе"
        }
      ],
      "referential_integrity": {
        "cascade_deletes": [
          {
            "parent": "ManagedGroup",
            "child": "GroupTopic",
            "action": "CASCADE",
            "description": "При удалении группы удаляются все её темы"
          },
          {
            "parent": "ManagedGroup",
            "child": "SourceSubscription",
            "action": "CASCADE",
            "description": "При удалении группы удаляются все её подписки"
          },
          {
            "parent": "GroupTopic",
            "child": "TopicSourceAssignment",
            "action": "CASCADE",
            "description": "При удалении темы удаляются все назначения в ней"
          }
        ],
        "restrict_deletes": [
          {
            "parent": "TelegramAccount",
            "child": "ContentSource",
            "action": "RESTRICT",
            "description": "Нельзя удалить пользователя, если у него есть созданные источники"
          },
          {
            "parent": "ContentSource",
            "child": "SourceSubscription",
            "action": "RESTRICT",
            "description": "Нельзя удалить источник, если на него есть активные подписки"
          }
        ]
      },
      "summary_statistics": {
        "total_tables": 7,
        "tables_with_primary_keys": 7,
        "tables_with_foreign_keys": 7,
        "unique_constraints": 8,
        "one_to_many_relationships": 12,
        "business_rules": 3,
        "json_fields": 3
      }
    }
  }