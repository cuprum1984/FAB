# Telegram Bot — получи у @BotFather
BOT_TOKEN=

# Neon PostgreSQL (скопируй полную строку из Neon Console → Connect)
DATABASE_URL=

# Альтернатива (если не хочешь полный URL) — но лучше использовать DATABASE_URL
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=neondb

# Интервал проверки фидов в секундах
SCHEDULE_INTERVAL=3600

# URL мини-аппа после деплоя
WEBAPP_URL=

# Telegram Stars provider token (из @BotFather → Payments)
STARS_PROVIDER_TOKEN=

# Опционально TON wallet
TON_WALLET=

# ✅ RATE LIMITING (защита от блокировок Telegram/YouTube)
# Telegram: 10 запросов/сек, ведро 20 токенов
RATE_LIMIT_TELEGRAM_TOKENS=20
RATE_LIMIT_TELEGRAM_REFILL=10.0

# YouTube: 1 запрос/сек, ведро 5 токенов
RATE_LIMIT_YOUTUBE_TOKENS=5
RATE_LIMIT_YOUTUBE_REFILL=1.0

# Глобальный лимит: 60 запросов в минуту
RATE_LIMIT_GLOBAL_PER_MINUTE=60

# ✅ SEMAPHORE (ограничение параллелизма мониторинга)
# Максимум одновременных запросов к источникам
SEMAPHORE_LIMIT=10

# ✅ ЗАЩИТА ОТ СПАМА ПОСЛЕ ПРОСТОЯ
# Если бот не работал больше этого времени (сек), отправляем только последние посты
DOWNTIME_THRESHOLD_SECONDS=600
# Максимум постов для отправки после простоя
DOWNTIME_MAX_POSTS=5

# ✅ ИНТЕРВАЛ ПРОВЕРКИ YOUTUBE
# 30 минут (1800 сек) для снижения нагрузки на YouTube API
YOUTUBE_PARSING_INTERVAL=1800
