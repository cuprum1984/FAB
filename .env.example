# Telegram Bot — получи у @BotFather
BOT_TOKEN=

# Neon PostgreSQL (скопируй полную строку из Neon Console → Connect)
DATABASE_URL=

# Альтернатива (если не хочешь полный URL) — но лучше использовать DATABASE_URL
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=neondb

# Интервал проверки фидов в секундах
SCHEDULE_INTERVAL=3600

# URL мини-аппа после деплоя
WEBAPP_URL=

# Telegram Stars provider token (из @BotFather → Payments)
STARS_PROVIDER_TOKEN=

# Опционально TON wallet
TON_WALLET=