# .env.local - для локальной разработки с SQLite
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
DATABASE_URL=sqlite+aiosqlite://./local_dev.db
ENV=development
LOG_LEVEL=DEBUG
