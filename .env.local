# .env.local — для локальной разработки с Docker PostgreSQL
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ✅ БД — PostgreSQL в Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myaggrybot

# ✅ Redis — Docker контейнер
REDIS_URL=redis://localhost:6379/0

# Режим
ENV=development
LOG_LEVEL=DEBUG
DEBUG=True

# Rate Limiting
RATE_LIMIT_TELEGRAM_TOKENS=20
RATE_LIMIT_TELEGRAM_REFILL=10.0
RATE_LIMIT_YOUTUBE_TOKENS=5
RATE_LIMIT_YOUTUBE_REFILL=1.0
RATE_LIMIT_GLOBAL_PER_MINUTE=60

# ✅ Для профилирования
PROFILE_MODE=0